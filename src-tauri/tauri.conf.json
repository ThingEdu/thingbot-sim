{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TiFa",
  "version": "0.1.2",
  "identifier": "vn.thingedu.fanrocgame",
  "build": {
    "frontendDist": "../dist-game",
    "beforeBuildCommand": "npm run build:game"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ThingBot FanRoc Challenge",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "copyright": "ThingEdu — AGPL-3.0 (mã nguồn: https://github.com/ThingEdu/thingbot-sim)",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../NGUON.md": "NGUON.md",
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
