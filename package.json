    "e2e:fanroc": "node scripts/fanroc-e2e.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.14.0",
    "jszip": "3.10.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/three": "0.180.0",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
