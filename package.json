{
  "name": "thingbot-sim",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "ThingBot Sim — web mô phỏng ThingBot theo bài học (spike bài 3: Nút bấm)",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
